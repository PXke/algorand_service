REDIS_BROKER_URL=redis://localhost:6379/1
REDIS_RESULT_URL=redis://localhost:6379/2

# Crawler types — see docs/modules/crawler-types.md (DB table crawler_config)
CRAWLER_HTTP_ENABLED=1
CRAWLER_WEB_SPA_ENABLED=0
CRAWLER_BROWSER_ENABLED=0
CRAWLER_MAIL_ENABLED=1
CRAWLER_REDDIT_ENABLED=0
CRAWLER_TELEGRAM_ENABLED=0
CRAWLER_DISCORD_ENABLED=0
CRAWLER_CHAIN_ENABLED=1
CRAWLER_METRICS_ENABLED=1

# IMAP official comms (fine to leave on if MAIL_IMAP_* is set)
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_POLL_SECONDS=300

# Discord crawler (two rooms in deploy/seeds/discord_services.toml)
DISCORD_BOT_TOKEN=
DISCORD_MESSAGE_LIMIT=50
DISCORD_POLL_SECONDS=300

# Reddit crawler (two communities in deploy/seeds/reddit_services.toml)
REDDIT_USER_AGENT=algorand-platform-newspaper/1.0 (contact: you@example.com)
REDDIT_POST_LIMIT=25
REDDIT_POLL_SECONDS=600

# Weekly digest (CoinGecko + feed highlights; optional Mistral)
PRICE_ANALYSIS_ENABLED=1
PRICE_ANALYSIS_ASSET_ID=algorand
PRICE_ANALYSIS_SERVICE_ID=weekly-digest
WEEKLY_DIGEST_INCLUDE_FEED=1
WEEKLY_DIGEST_LOOKBACK_DAYS=7
WEEKLY_DIGEST_MAX_ARTICLES=25

# Price metrics (hourly CoinGecko polls → Cassandra → Mistral context)
PRICE_METRICS_ENABLED=1
PRICE_METRICS_ASSET_ID=algorand
PRICE_METRICS_POLL_SECONDS=3600
PRICE_ANALYSIS_CRON_DOW=mon
PRICE_ANALYSIS_CRON_HOUR=9
PRICE_ANALYSIS_CRON_MINUTE=0

# Mistral AI article generation (optional; falls back to template by default)
MISTRAL_ENABLED=0
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MODEL_WRITER=mistral-medium-latest
MISTRAL_MODEL_RESEARCH=mistral-small-latest
MISTRAL_MODEL_DIGEST=mistral-small-latest
MISTRAL_API_BASE=https://api.mistral.ai/v1
MISTRAL_MAX_TOKENS=1024
MISTRAL_TIMEOUT_SECONDS=60
MISTRAL_FALLBACK_TEMPLATE=1
MISTRAL_MAX_SOURCE_CHARS=6000
# Beat: poll all scrape sources for diffs and publish with Mistral
MISTRAL_DIFF_POLL_SECONDS=600

# Writer enrichment + admin suggestion box (Cassandra editorial_briefs)
WRITER_ENRICHMENT_ENABLED=1
WRITER_EDITORIAL_BRIEFS_ENABLED=1
ARTICLE_EDIT_WINDOW_HOURS=24

# URL queue (Cassandra) — chain/social discovery → web crawler
URL_QUEUE_ENABLED=1
URL_QUEUE_DRAIN_SECONDS=60
WRITER_FETCH_ENQUEUE_ENABLED=1
WRITER_FETCH_ENQUEUE_PRIORITY=45
# Stage 3 LLM rubric (narrative synthesis + technical depth, 1-5)
WRITER_QUALITY_LLM_ENABLED=1
WRITER_QUALITY_LLM_MIN_SCORE=3

# Discovery mode (extract URLs from chain txs)
DISCOVERY_MODE_ENABLED=1

# External link discovery (reddit/discord/telegram → url_queue)
EXTERNAL_LINK_DISCOVERY_ENABLED=1

# Web crawler SPA fallback (HTTP then Playwright)
SPA_FALLBACK_ENABLED=1

# Two-tier relevance: storage vs publish
MIN_STORAGE_SCORE=5

# Content categorization (Mistral + fallback)
CONTENT_CATEGORIZATION_ENABLED=1

# Publish classifier + admin feedback loop
PUBLISH_CLASSIFIER_ENABLED=1
PUBLISH_CLASSIFIER_MODEL_PATH=data/models/publish_classifier.pkl
CLASSIFIER_CONFIDENCE_THRESHOLD=0.8
CLASSIFIER_SAMPLING_THRESHOLD=0.0
CLASSIFIER_RETRAIN_CRON_HOUR=3
CLASSIFIER_RETRAIN_CRON_MINUTE=30
