# Celery workers env — bootstrapped to ${TARGET_PATH}/shared/workers.env on
# first deploy and symlinked into each release. Edit on the host, then restart:
#   systemctl restart algorand-platform-celery algorand-platform-celery-beat
# Free-threaded Python only (python3.15t). Do NOT set on a normal GIL build —
# PYTHON_GIL=0 fatals at startup. Deploy scripts set this automatically when
# the venv interpreter reports "free-threading".
#PYTHON_GIL=0
# Redis DBs 10-12 are reserved for this platform (0/1 belong to other apps on this host)
REDIS_URL=redis://localhost:6379/10
REDIS_BROKER_URL=redis://localhost:6379/11
REDIS_RESULT_URL=redis://localhost:6379/12

CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_KEYSPACE=algorand_platform
# Same role as backend.env (created once by an admin; see deploy/README.md)
CASSANDRA_USERNAME=algorand
CASSANDRA_PASSWORD=

ALGOD_URL=https://mainnet-api.algonode.cloud
#ALGOD_TOKEN_FILE=/var/lib/algorand/algod.token

# Bugsnag error reporting — opt-in: empty/absent disables it entirely.
# Set the project key on the host to enable (release stage follows APP_ENV).
BUGSNAG_API_KEY=

# IndexNow: notifies Bing/Ecosia/DuckDuckGo, Yandex, Seznam, Naver on publish.
# Defaults are baked into workers config; override only to rotate the key (must
# match deploy.conf INDEXNOW_KEY, which is served as {key}.txt at the site root).
PUBLIC_SITE_URL=https://algorand.pxke.me
INDEXNOW_KEY=63e7ffa13f3ca734700ca375c0581b41

# Crawler lanes (default off without a DB flag row). Web powers the
# snapshot-diff pipeline on registry sources; reddit polls reddit:// sources.
CRAWLER_WEB_ENABLED=1
CRAWLER_REDDIT_ENABLED=1
# Playwright sub-lane for SPA/thin pages (chromium installed by deploy.sh)
CRAWLER_WEB_SPA_ENABLED=1
# Send 10% of confident classifier decisions to the admin review queue as
# training data (low-confidence pages always go there).
CLASSIFIER_SAMPLING_THRESHOLD=0.1
REDDIT_USER_AGENT="algorand-platform-newspaper/1.0 (by /u/pxke; contact px9e@proton.me)"
# TODO(operator): Reddit blocks anonymous server-side JSON access (403).
# Create a "script" app at https://www.reddit.com/prefs/apps and set:
#REDDIT_OAUTH_ENABLED=1
#REDDIT_CLIENT_ID=
#REDDIT_CLIENT_SECRET=

# Publish policy (see deployment-checklist.md §6)
NEWS_MAX_ARTICLES_PER_DAY=7
# NEWS_MAX_BREAKING_PER_DAY / BREAKING_TIER_ENABLED / BREAKING_INLINE_DRAIN /
# PUBLISH_BREAKING_DRAIN_SECONDS removed 2026-08-25: the BREAKING publish
# tier fast path was retired entirely (owner's call).

# TODO(operator): LLM article generation — REQUIRED, no template fallback
# exists. MISTRAL_ENABLED is the master "LLM composition enabled at all"
# switch (the name predates DeepSeek and is otherwise misleading -- leave it
# on even on an all-DeepSeek deploy). DeepSeek is the live default provider
# for every purpose now (LLM_PROVIDER_WRITER/RESEARCH/DIGEST/TRANSLATE/RUBRIC
# all default to "deepseek"), so what actually needs to be set below is
# DEEPSEEK_API_KEY -- a missing/rotated key now makes composition raise
# loudly instead of silently continuing on the retired Mistral provider.
# MISTRAL_API_KEY is only needed if an LLM_PROVIDER_* var is explicitly set
# back to "mistral".
MISTRAL_ENABLED=0
#MISTRAL_API_KEY=
#DEEPSEEK_API_KEY=
# Article writer runs an agentic tool loop; medium has the tool discipline the
# IMPORTANT: use a PINNED version, not "-latest" (aliases can be throttled to a low
# TPM tier on this account). The writer is an agentic tool loop, so tool-calling
# reliability matters most. A ToolCall-15 benchmark ranked Small 4 (2603) best (83%,
# perfect tool selection + error recovery), ahead of Medium-3.1 (80%) and Large-3
# (70%). We run mistral-small-2603. Fall back to mistral-medium-2508 for richer prose.
# Only read when LLM_PROVIDER_WRITER=mistral -- DeepSeek's own model knobs
# are DEEPSEEK_MODEL_WRITER/RESEARCH/DIGEST/TRANSLATE (baked-in defaults;
# override only to pin a different DeepSeek model).
#MISTRAL_MODEL_WRITER=mistral-small-2603
# Per-call output cap. 12000 fits a ~4000-word long-form article without truncation.
#MISTRAL_MAX_TOKENS=12000
# Agentic writer: let it take as many tool rounds as it needs (quality > latency).
#LLM_MAX_TOOL_ROUNDS=20
# Client-side rate limiting (shared across workers via Redis), covering BOTH
# LLM providers (Mistral and DeepSeek) through one gate -- see llm_rate_limit.py.
# Raise the interval if either account's requests/sec cap is lower than the
# default (e.g. a model with a stricter rps than deepseek-v4-flash/mistral-small).
#LLM_MIN_REQUEST_INTERVAL_SECONDS=5.0
#MISTRAL_MAX_RETRIES=4

# Writer research tools.
# Bluesky community-sentiment search. Free, but searchPosts needs an
# app-password session: create one at https://bsky.app/settings/app-passwords
# and set both vars below. Tool stays unregistered until both are present.
#BLUESKY_SEARCH_ENABLED=1
#BLUESKY_IDENTIFIER=yourhandle.bsky.social
#BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# General web search via self-hosted SearXNG (no Google, no key, no per-query
# cost). Empty = web search tool stays disabled. Run SearXNG on the host with
# JSON output enabled, then point this at it, e.g. http://127.0.0.1:8888
#SEARXNG_URL=
# X (Twitter) search: a weekly beat task sweeps every tracked ecosystem
# service (one X API call each) into a Cassandra cache; the writer's
# search_x tool reads that cache, never X live, so per-compose cost is zero.
# Master switch + the token the weekly sweep authenticates with -- tool
# stays unregistered and the beat entry stays unscheduled until both are set.
#X_SEARCH_ENABLED=1
#X_BEARER_TOKEN=
# Defensive ceiling on services swept per run, not a spend-limiting knob.
#X_SEARCH_WEEKLY_SWEEP_MAX_SERVICES=200

# Optional crawler lanes
#TELEGRAM_BOT_TOKEN=
#MAIL_IMAP_HOST=
#MAIL_IMAP_USER=
#MAIL_IMAP_PASSWORD=

# Agent wallet (connect_wallet tool) — WalletConnect LOGIN only. Signing is
# allowlisted down to zero capability to move value or change account
# control, even though this is a MainNet keypair holding real ALGO (see
# workers/app/modules/wallet/signer.py). Off by default.
#AGENT_WALLET_ENABLED=1
#AGENT_WALLET_MNEMONIC=
#WALLET_CONNECT_MAX_PER_COMPOSE=1
