# Backend API env — bootstrapped to ${TARGET_PATH}/shared/backend.env on first
# deploy and symlinked into each release. Edit on the host, then restart:
#   systemctl restart algorand-platform-backend
APP_ENV=prod
APP_HOST=127.0.0.1
APP_PORT=@APP_PORT@

# Gunicorn (gthread). Workers = processes (default 1).
# Threads default to CPU count (nproc) — 1:1 with cores. Override only if needed.
#GUNICORN_WORKERS=1
#GUNICORN_THREADS=
#APP_PROCESSES=1
#APP_THREADS=

# Free-threaded Python only (python3.15t). Do NOT set on a normal GIL build —
# PYTHON_GIL=0 fatals at startup. Deploy scripts set this automatically when
# the venv interpreter reports "free-threading".
#PYTHON_GIL=0

# Bugsnag error reporting — opt-in: empty/absent disables it entirely.
# Set the project key on the host to enable (release stage follows APP_ENV).
BUGSNAG_API_KEY=

# Wallet login sessions last ~30 days (default was 1h — too short for daily use)
SESSION_TTL_SECONDS=2592000

AUTH_DOMAIN=@SITE_DOMAIN@
AUTH_URI=https://@SITE_DOMAIN@/sign-in
CORS_ALLOWED_ORIGINS=https://@SITE_DOMAIN@

# Public site URL — used to build absolute canonical / Open Graph / sitemap URLs
# in the server-rendered document routes (/, /news/articles/*, sitemaps).
PUBLIC_SITE_URL=https://@SITE_DOMAIN@
SITE_NAME=PXke Algorand
# Google-News sitemap — served + advertised in robots.txt. Harmless until
# accepted into Google News Publisher Center; on so it's ready when we apply.
SEO_NEWS_SITEMAP_ENABLED=true

NEWS_STORE=cassandra
SUGGESTION_STORE=cassandra
UPVOTE_STORE=cassandra
SUGGESTIONS_ENABLED=false

# Chain reads. Public AlgoNode works; a local node is better for the pulse
# (this host's algod is on 8080 — set ALGOD_URL=http://127.0.0.1:8080 and
# ALGOD_TOKEN_FILE=/var/lib/algorand/algod.token).
ALGOD_URL=https://mainnet-api.algonode.cloud
#ALGOD_TOKEN_FILE=/var/lib/algorand/algod.token

CASSANDRA_HOSTS=127.0.0.1
# Cassandra on this host requires auth. The role is created once by an admin
# (see deploy/README.md "Cassandra role"); migrations and the app both use it.
CASSANDRA_USERNAME=algorand
CASSANDRA_PASSWORD=
# Redis DBs 10-12 are reserved for this platform (0/1 belong to other apps on this host)
REDIS_URL=redis://localhost:6379/10
# Same broker the workers consume (db11) — used for queue-depth health checks
# and the admin "run scraper" buttons.
CELERY_BROKER_URL=redis://localhost:6379/11

# Push-ingest auth (header X-Ingest-Key) — generated on first deploy
INGEST_API_KEY=@INGEST_KEY@

# TODO(operator): set these to enable admin endpoints / suggestion payments
# (see docs/modules/deployment-checklist.md §3)
#ADMIN_WALLET_ADDRESSES=
#PLATFORM_TREASURY_ADDRESS=

# Typesense (optional; search falls back to feed scan without it)
#TYPESENSE_HOST=localhost
#TYPESENSE_PORT=8108
#TYPESENSE_PROTOCOL=http
#TYPESENSE_API_KEY=
