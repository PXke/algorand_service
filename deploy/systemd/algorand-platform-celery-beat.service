[Unit]
Description=Algorand Platform Celery Beat (chain tail schedule)
After=network-online.target algorand-platform-celery.service
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@TARGET_PATH@/releases/current/workers
EnvironmentFile=-@TARGET_PATH@/releases/current/workers/.env
ExecStart=/usr/bin/bash @TARGET_PATH@/releases/current/deploy/scripts/run_celery.sh beat
Restart=on-failure
RestartSec=5
# Beat has no in-flight work to drain — exit promptly on restart.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=algorand-platform-celery-beat

[Install]
WantedBy=multi-user.target
