[Unit]
Description=Algorand Platform Backend (Falcon + Gunicorn)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@TARGET_PATH@/releases/current/backend
EnvironmentFile=-@TARGET_PATH@/releases/current/backend/.env
# Gunicorn gthread: 1 worker, threads=nproc, each thread pinned to one core
# (see deploy/scripts/run_backend.sh + app.core.gunicorn_affinity).
# PYTHON_GIL=0 is set there only for free-threaded (python3.15t) venvs.
ExecStart=/usr/bin/bash @TARGET_PATH@/releases/current/deploy/scripts/run_backend.sh
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=algorand-platform-backend

[Install]
WantedBy=multi-user.target
