# Conduit pipeline: algod (follower) -> Cassandra
# Build: make -C conduit && ./conduit/conduit -f conduit/config/conduit.yml

log-level: info
retry:
  count: 5
  delay: 1s
  max-delay: 30s

importer:
  name: algod
  config:
  # Follower mode is required for ledger state deltas (ARC / indexer parity).
    mode: follower
    netaddr: "http://127.0.0.1:4001"
    token: "your-algod-api-token"
    catchup: true

processors:

exporter:
  name: cassandra
  config:
    hosts:
      - "127.0.0.1"
    port: 9042
    keyspace: algorand_platform
    consistency: QUORUM
    auto_migrate: true
    write_transactions_by_sender: true
