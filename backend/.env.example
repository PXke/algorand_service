APP_NAME=algorand-platform-api
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=2592000
NONCE_TTL_SECONDS=300
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_KEYSPACE=algorand_platform
CASSANDRA_LOCAL_DC=datacenter1
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=changeme
# For Flutter web on localhost, use AUTH_DOMAIN=localhost and matching CORS origins.
AUTH_DOMAIN=localhost
AUTH_URI=https://algorand-platform.local/sign-in
AUTH_STATEMENT=Sign in to the Algorand Platform.
AUTH_CAIP2_CHAIN_ID=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDe
AUTH_WALLET_CONNECT_CHAIN_ID=416002

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
# Omit or leave unset: dev/test accept any browser Origin (Flutter web, Electron renderer, etc.).
# CORS_PERMISSIVE=false
# Production / packaged desktop: add custom origins, e.g. app://your-app-id
PLATFORM_TREASURY_ADDRESS=
SUGGESTION_MIN_MICROALGOS=10000
SUGGESTION_STORE=memory
UPVOTE_STORE=memory
NEWS_STORE=memory
NEWS_FEED_BUCKET=main
NEWS_FEED_LIMIT=50

# Comma-separated Algorand addresses allowed for /api/v1/admin/* (X-Admin-Wallet header)
ADMIN_WALLET_ADDRESSES=

# Push ingest from Firefox extension / local browser bridge (X-Ingest-Key)
INGEST_API_KEY=

# x402 paid-endpoint plumbing (Algorand Global x402 Challenge). Off until set.
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz/
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
X402_PAY_TO_ADDRESS=
