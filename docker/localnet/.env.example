# Use with: docker compose --env-file docker/localnet/.env --profile app --profile localnet up -d
#
# In-container services talk to algod by hostname; from the host use localhost:4001.

COMPOSE_PROFILES=app,localnet

ALGOD_URL=http://algod:4001
ALGOD_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGOD_NETADDR=http://algod:4001

# Sandbox dev token (64 x 'a') — same as Algorand Sandbox / default AlgoKit LocalNet.
# If you use a host-side AlgoKit instance instead of profile `localnet`, copy its token here;
# a mismatch causes 401 from algod and broken wallet/Conduit startup.
