# Optional overrides (TESTING ONLY).
# Copy to docker/.env (gitignored) for secrets — loaded by app profile services via compose env_file.
# Localnet stack: prefer docker/localnet/.env.example

# Comma-separated Algorand addresses for /api/v1/admin/* (must match Flutter --dart-define).
# ADMIN_WALLET_ADDRESSES=YOUR_WALLET_ADDRESS_HERE

# COMPOSE_PROFILES=app,localnet,chain

# Public TestNet (default when localnet profile is off)
ALGOD_URL=https://testnet-api.algonode.cloud
# ALGOD_TOKEN=

# SKIP_ARC0060_TESTS=0

# Discord newspaper crawler (deploy/seeds/discord_services.toml)
# DISCORD_BOT_TOKEN=
# DISCORD_POLL_SECONDS=300

# Reddit newspaper crawler (deploy/seeds/reddit_services.toml)
# REDDIT_USER_AGENT=algorand-platform-newspaper/1.0 (contact: you@example.com)
# REDDIT_POLL_SECONDS=600

# Mistral AI (workers newspaper compose)
# MISTRAL_ENABLED=1
# MISTRAL_API_KEY=your-mistral-api-key
