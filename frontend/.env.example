VITE_API_BASE_URL=
VITE_AUTH_DOMAIN=localhost
VITE_ADMIN_WALLET_ADDRESSES=
VITE_SUGGESTIONS_ENABLED=false
VITE_EXPLORER_BASE_URL=https://testnet.explorer.perawallet.app
# Empty = /api/v1/algod on this API (the operator's node). Override only to
# point at a public relay.
VITE_ALGOD_API_URL=

# Bugsnag browser error reporting — opt-in: empty disables it entirely, and
# it never reports from a dev build (`vite dev`) even if a key is set, only
# from a production build (`vite build`). Separate notifier project/key from
# the backend & workers BUGSNAG_API_KEY (Python). deploy/package.sh writes
# this from FRONTEND_BUGSNAG_API_KEY (see deploy/deploy.conf) at build time.
VITE_BUGSNAG_API_KEY=
# Build correlation id shown on Bugsnag events (git short SHA in real
# deploys, via deploy/package.sh). Leave empty for local dev.
VITE_APP_VERSION=
